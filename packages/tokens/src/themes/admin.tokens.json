{
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": ["Source Sans 3", "sans-serif"]
      }
    }
  },
  "color": {
    "bg": { "default": { "$type": "color", "$value": "#ffffff" } },
    "text": {
      "default": { "$type": "color", "$value": "#1f1f1f" },
      "muted": { "$type": "color", "$value": "#8a8a8a" }
    },
    "action": {
      "bg": { "$type": "color", "$value": "#b3001b" },
      "text": { "$type": "color", "$value": "#ffffff" }
    }
  }
}

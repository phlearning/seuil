{
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$description": "New commune brand: system fonts only, so nothing is downloaded from a third party.",
        "$value": ["Avenir Next", "Segoe UI", "Roboto", "Helvetica Neue", "system-ui", "sans-serif"]
      }
    }
  },
  "color": {
    "bg": { "default": { "$type": "color", "$value": "#ffffff" } },
    "text": {
      "default": { "$type": "color", "$value": "#1f1f1f" },
      "muted": { "$type": "color", "$value": "#545454" }
    },
    "action": {
      "bg": { "$type": "color", "$value": "#b3001b" },
      "text": { "$type": "color", "$value": "#ffffff" }
    }
  }
}

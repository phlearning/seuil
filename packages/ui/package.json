{
  "name": "@seuil/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React components that only consume @seuil/tokens CSS variables, documented in Storybook.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build --quiet -o storybook-static",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@seuil/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "storybook": "10.6.7",
    "vite": "8.3.8"
  }
}
